<Project>
  <!-- Machine-specific paths go in Local.props (git-ignored), e.g.
       <Project><PropertyGroup><KSPRefDir>D:\SteamLibrary\steamapps\common\Kerbal Space Program</KSPRefDir></PropertyGroup></Project>
       Values there win over the defaults below; environment variables win over both. -->
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />
  <PropertyGroup>
    <!-- MSBuild property names are case-insensitive, so a KSPREFDIR / KSPTESTDIR environment variable already overrides these. -->
    <!-- KSPRefDir is a read-only reference install: only its DLLs are read, nothing is ever written there. -->
    <KSPRefDir Condition="'$(KSPRefDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSPRefDir>
    <!-- KSPTestDir is the throwaway KSP copy where the automated scenarios run. -->
    <KSPTestDir Condition="'$(KSPTestDir)' == ''">C:\KSP_SubterraTest</KSPTestDir>
    <!-- KSPBuildDir is the install whose DLLs the plugin is compiled against (default: KSPRefDir). Subterra runs on KSP 1.12.5
         and on Retooled (Lucas): built against 1.12.5's Unity 2019 API, the oldest, one DLL serves both (Retooled relinks
         it); what differs is found at run time (PhysicsBake). -->
    <KSPBuildDir Condition="'$(KSPBuildDir)' == ''">$(KSPRefDir)</KSPBuildDir>
    <KSPManaged>$(KSPBuildDir)\KSP_x64_Data\Managed</KSPManaged>
    <HarmonyDll>$(KSPBuildDir)\GameData\000_Harmony\0Harmony.dll</HarmonyDll>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.2.0</Version>
  </PropertyGroup>
</Project>
